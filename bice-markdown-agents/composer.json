{
    "name": "bice/markdown-agents",
    "description": "WordPress plugin: HTTP content negotiation serving Markdown to AI agents (Accept: text/markdown).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "league/html-to-markdown": "^5.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": false
    }
}